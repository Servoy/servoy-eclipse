{
  "name": "TiNG",
  "version": "2026.9.0",
  "description": "Servoy TiNG 2026.9.0",
  "license": "GNU Affero General Public License",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production --subresource-integrity=true ngclient2",
    "build_sourcemap": "ng build ngclient2 --configuration production --subresource-integrity=true --source-map",
    "build_lib": "ng build @servoy/public --configuration production",
    "build_lib_debug_nowatch": "ng build @servoy/public --watch=false",
    "build_debug": "ng build ngclient2 --watch",
    "build_debug_nowatch": "ng build ngclient2 --watch=false",
    "build_lib_debug": "ng build @servoy/public --watch",
    "build_default_debug": "ng build @servoy/servoydefault --watch",
    "build_mobile": "ng build --configuration mobile --subresource-integrity=true ngclient2",
    "build_mobile_debug": "ng build --configuration development_mobile ngclient2",
    "test": "ng test ngclient2 --no-watch",
    "test:watch": "ng test ngclient2",
    "test:ui": "ng test ngclient2 --ui",
    "test_public": "ng test @servoy/public --no-watch",
    "test_public:watch": "ng test @servoy/public",
    "test_default": "ng test @servoy/servoydefault --no-watch",
    "test_default:watch": "ng test @servoy/servoydefault",
    "test_dialogs": "ng test @servoy/dialogs --no-watch",
    "test_dialogs:watch": "ng test @servoy/dialogs",
    "test_window": "ng test @servoy/window --no-watch",
    "test_window:watch": "ng test @servoy/window",
    "test_ngclientutils": "ng test @servoy/ngclientutils --no-watch",
    "test_ngclientutils:watch": "ng test @servoy/ngclientutils",
    "update": "ng update",
    "lint": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng.js lint"
  },
  "private": true,
  "dependencies": {
    "@ag-grid-community/locale": "36.1.0",
    "@angular/animations": "22.1.0",
    "@angular/common": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/localize": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/platform-browser-dynamic": "22.1.0",
    "@angular/router": "22.1.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@servoy/public": "file:dist-public",
    "ag-grid-angular": "36.1.0",
    "ag-grid-enterprise": "36.1.0",
    "bignumber.js": "11.1.5",
    "lodash-es": "4.18.1",
    "luxon": "3.7.2",
    "numbro": "2.5.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.1.3",
    "@angular-devkit/schematics": "22.1.3",
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler": "22.1.0",
    "@angular/compiler-cli": "22.1.0",
    "@angular/language-service": "22.1.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/estree": "1.0.9",
    "@types/lodash-es": "4.17.12",
    "@types/luxon": "3.7.3",
    "@types/node": "26.1.2",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.0",
    "eslint-plugin-only-warn": "1.2.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jsdom": "^30.0.1",
    "ng-packagr": "22.1.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.0": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.6": true
  }
}
