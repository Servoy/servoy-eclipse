{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/spec",
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@servoy/public": [
        "../projects/servoy-public/src/public-api"
      ]
    }
  },
  "files": [],
  "include": [
    "**/*.spec.ts",
    "**/*.ts",
    "**/*.d.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
