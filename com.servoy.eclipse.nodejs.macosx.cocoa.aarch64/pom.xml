<?xml version="1.0" encoding="UTF-8"?>
<project
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>
    <prerequisites>
        <maven>3.9.0</maven>
    </prerequisites>
	<parent>
		<groupId>com.servoy</groupId>
		<artifactId>servoy-eclipse</artifactId>
		<version>2026.12.0-SNAPSHOT</version>
	</parent>
	<artifactId>com.servoy.eclipse.nodejs.macosx.cocoa.aarch64</artifactId>
	<version>24.18.0</version>
	<packaging>eclipse-plugin</packaging>
	<properties>
		<pnpm.version>12.5.1</pnpm.version>
	</properties>
	<build>
		<plugins>
			<plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.8.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <url>https://nodejs.org/dist/v${project.version}/node-v${project.version}-darwin-arm64.tar.gz</url>
                            <outputFileName>node.tar.gz</outputFileName>
                            <unpack>false</unpack>
                            <overwrite>true</overwrite>
                            <outputDirectory>${basedir}/</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>download-pnpm</id>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <url>https://github.com/pnpm/pnpm/releases/download/v${pnpm.version}/pnpm-darwin-arm64.tar.gz</url>
                            <outputFileName>pnpm.tar.gz</outputFileName>
                            <unpack>false</unpack>
                            <overwrite>true</overwrite>
                            <outputDirectory>${basedir}/</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
		</plugins>
	</build>
</project>
