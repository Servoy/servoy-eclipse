// Combined coverage of all Servoy repos in ONE report (ReportGenerator, https://github.com/danielpalme/ReportGenerator).
//
// Every repo PUSHES its own coverage; this job never reads other jobs (Copy Artifact would need a permission in
// every source job). The pushed reports live in a staging folder per branch line on the Jenkins controller:
//     $JENKINS_HOME/coverage-staging/<line>/<source>/...      (<line> = folder of this job: master, lts_2026, ...)
// and always hold the LAST coverage of every source, so the combined report is complete also when only one repo
// was rebuilt.
//   - Jenkins jobs: at the end of a SUCCESS/UNSTABLE build, pushCoverage(...) in their Jenkinsfile copies their
//     jacoco.xml / cobertura-coverage.xml files to that folder and starts this job (see the servoy-client Jenkinsfile).
//   - GitHub repos: the action .github/actions/upload-coverage in this repo starts this job through the REST API
//     (buildWithParameters) with the reports as zip; the 'Store upload' stage puts it in the staging folder.
//
// Result: the 'Combined Coverage' tab on the job page (one row per repo/bundle, with history charts) and the
// build artifacts Summary.csv, Summary.json, Cobertura.xml, SummaryGithub.md and coverage-report-html.zip,
// which are the "export" of the combined numbers.
//
// Setting up the job (once):
//   - Pipeline job 'coverage' in the branch folder (master/coverage), "Pipeline script from SCM", git
//     https://github.com/Servoy/servoy-eclipse.git, script path 'Jenkinsfile.coverage'. Do NOT add
//     'Clean before checkout': the workspace keeps the report history and the downloaded tools.
//   - For GitHub uploads: a Jenkins user with 'Job/Build' on this job and an API token for it, stored as the
//     GitHub secrets JENKINS_COVERAGE_USER / JENKINS_COVERAGE_TOKEN (see the action for the workflow snippet).

pipeline {
    agent any

    options {
        // never two builds at once (shared report history)
        disableConcurrentBuilds()
        // several pushes that arrive at about the same time end up in one run
        quietPeriod(60)
        buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '5'))
        timeout(time: 30, unit: 'MINUTES')
    }

    triggers {
        // nightly, so the report and its history are refreshed also on days without pushes
        cron('H 3 * * *')
    }

    parameters {
        string(name: 'COVERAGE_SOURCE', defaultValue: '', trim: true,
            description: 'Only for GitHub uploads (set by the upload action): repo name of the zip below. Leave empty for a normal run.')
        stashedFile(name: 'COVERAGE_ZIP',
            description: 'Only for GitHub uploads (set by the upload action): zip with the jacoco.xml / cobertura-coverage.xml files of that repo.')
    }

    environment {
        COVERAGE_TITLE = 'Servoy combined coverage'
    }

    stages {
        stage('Store upload') {
            when {
                expression { params.COVERAGE_SOURCE?.trim() }
            }
            steps {
                // COVERAGE_ZIP is the path of the uploaded zip, COVERAGE_SOURCE the repo name (validated in the script)
                withFileParameter('COVERAGE_ZIP') {
                    sh 'bash ci/coverage/ingest-upload.sh "$COVERAGE_ZIP" "$COVERAGE_SOURCE" "$JENKINS_HOME/coverage-staging/${JOB_NAME%/*}"'
                }
            }
        }

        stage('Collect') {
            steps {
                // work on a copy, so a push that lands during this run cannot change the input halfway
                sh '''
                    set -eu
                    staging="$JENKINS_HOME/coverage-staging/${JOB_NAME%/*}"
                    rm -rf incoming prepared report-html report-data coverage-report-html.zip
                    mkdir -p incoming
                    if [ -d "$staging" ]; then
                        for d in "$staging"/*/; do
                            name="$(basename "$d")"
                            case "$name" in .*|*.new.*|*.old) continue ;; esac
                            cp -r "$d" "incoming/$name"
                            echo "coverage of $name: $(find "incoming/$name" -type f | wc -l) file(s)"
                        done
                    fi
                '''
            }
        }

        stage('Combine') {
            steps {
                sh 'bash ci/coverage/aggregate.sh'
            }
        }

        stage('Publish') {
            steps {
                script {
                    def summary = readJSON file: 'report-data/Summary.json'
                    currentBuild.description = "Lines ${summary.summary.linecoverage}% | branches ${summary.summary.branchcoverage}% | ${summary.summary.assemblies} reports" +
                        (params.COVERAGE_SOURCE?.trim() ? " | upload: ${params.COVERAGE_SOURCE}" : '')
                }
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: false,
                    reportDir: 'report-html',
                    reportFiles: 'index.html',
                    reportName: 'Combined Coverage'
                ])
                zip zipFile: 'coverage-report-html.zip', dir: 'report-html', archive: false
                archiveArtifacts artifacts: 'report-data/Summary.csv, report-data/Summary.json, report-data/Cobertura.xml, report-data/SummaryGithub.md, report-data/sources.txt, coverage-report-html.zip',
                    fingerprint: false
            }
        }
    }
}
