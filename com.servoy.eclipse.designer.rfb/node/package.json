{
  "name": "servoy-designer",
  "version": "2026.12.0",
  "description": "Designer of Servoy",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build_debug": "ng build --watch",
    "build_debug_nowatch": "ng build --watch=false",
    "test": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage --coverage-include \"src/**/*.ts\" --coverage-exclude \"**/*.spec.ts\" --coverage-exclude \"**/*.browser.spec.ts\" --coverage-exclude \"**/*.d.ts\" --coverage-exclude \"**/main.ts\" --coverage-exclude \"**/environments/**\"",
    "test:watch": "ng test",
    "test:ui": "ng test --ui",
    "test:browser": "ng run servoy-designer:test-browser --no-watch",
    "test:browser:coverage": "ng run servoy-designer:test-browser --no-watch --coverage --coverage-include \"src/**/*.ts\" --coverage-exclude \"**/*.spec.ts\" --coverage-exclude \"**/*.d.ts\" --coverage-exclude \"**/main.ts\" --coverage-exclude \"**/environments/**\"",
    "test:browser:watch": "ng run servoy-designer:test-browser",
    "coverage:merge": "node scripts/coverage-merge.js ../target/coverage/jsdom/lcov.info ../target/coverage/browser/lcov.info ../target/coverage/combined",
    "lint": "ng lint",
    "lint:ci": "ng lint --format checkstyle --output-file ../target/eslint-checkstyle.xml"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@popperjs/core": "2.11.8",
    "@servoy/designer": "file:../../com.servoy.eclipse.ngclient.ui/node/dist-designer/servoy-designer.tgz",
    "@servoy/public": "file:../../com.servoy.eclipse.ngclient.ui/node/dist-public/servoy-public.tgz",
    "@servoy/sablo": "file:../../com.servoy.eclipse.ngclient.ui/node/dist-sablo/servoy-sablo.tgz",
    "bootstrap": "5.3.9",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.8.0",
    "@angular-eslint/schematics": "22.8.0",
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/localize": "22.3.0",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "26.6.11",
    "@vitest/browser-playwright": "5.1.2",
    "@vitest/coverage-v8": "5.1.2",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "eslint-formatter-checkstyle": "9.0.1",
    "eslint-plugin-only-warn": "1.2.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
